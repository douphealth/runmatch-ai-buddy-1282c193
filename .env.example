# Browser-side Supabase settings (safe to expose: the anon key is public by design and
# every table is protected by row-level security).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# NEVER add secrets here (service_role, BREVO_API_KEY, STRIPE_SECRET_KEY, SERPAPI_KEY_*).
# Server-side secrets live in Supabase Edge Function secrets / GitHub Actions secrets.
